# ==============================================================================
# Breaxo Tech - Environment Configuration Template
# Copy this file to .env or .env.local and populate the values below.
# ==============================================================================

# Web3Forms Public Access Key (Required for live contact form submission)
# Obtain your access key at: https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# (Optional) Custom hCaptcha Site Key
# If omitted, Web3Forms's standard zero-config hCaptcha widget is used automatically.
# NEXT_PUBLIC_HCAPTCHA_SITEKEY=
